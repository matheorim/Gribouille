<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>

<MenuBar xmlns="http://javafx.com/javafx/25"
         xmlns:fx="http://javafx.com/fxml/1"
         fx:controller="iut.gon.gribouille_tp1.controleurs.MenusControleur">
  <menus>
    <Menu mnemonicParsing="false" text="Dessin">
      <items>
        <MenuItem mnemonicParsing="false" text="Charger" />
        <MenuItem mnemonicParsing="false" text="Sauvegarder" />
        <MenuItem mnemonicParsing="false" text="Exporter" />
        <SeparatorMenuItem mnemonicParsing="false" />
        <MenuItem mnemonicParsing="false" text="Quitter" onAction="#onQuitte" />
      </items>
    </Menu>
    <Menu mnemonicParsing="false" text="Outils">
      <items>
        <Menu mnemonicParsing="false" text="Epaisseur">
          <items>
            <RadioMenuItem mnemonicParsing="false" text="1">
              <toggleGroup><ToggleGroup fx:id="épaisseur" /></toggleGroup>
            </RadioMenuItem>
            <RadioMenuItem mnemonicParsing="false" text="2" toggleGroup="$épaisseur" />
            <RadioMenuItem mnemonicParsing="false" text="3" toggleGroup="$épaisseur" />
            <RadioMenuItem mnemonicParsing="false" text="4" toggleGroup="$épaisseur" />
            <RadioMenuItem mnemonicParsing="false" text="5" toggleGroup="$épaisseur" />
            <RadioMenuItem mnemonicParsing="false" text="6" toggleGroup="$épaisseur" />
            <RadioMenuItem mnemonicParsing="false" text="7" toggleGroup="$épaisseur" />
            <RadioMenuItem mnemonicParsing="false" text="8" toggleGroup="$épaisseur" />
            <RadioMenuItem mnemonicParsing="false" text="9" toggleGroup="$épaisseur" />
          </items>
        </Menu>
        <RadioMenuItem mnemonicParsing="false" text="Crayon">
          <toggleGroup><ToggleGroup fx:id="outils" /></toggleGroup>
        </RadioMenuItem>
        <RadioMenuItem mnemonicParsing="false" text="Étoile" toggleGroup="$outils" />
      </items>
    </Menu>
    <Menu mnemonicParsing="false" text="Aide">
      <items>
        <MenuItem mnemonicParsing="false" text="A propos" />
      </items>
    </Menu>
  </menus>
</MenuBar>