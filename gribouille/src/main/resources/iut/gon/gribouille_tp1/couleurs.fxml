<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Rectangle?>

<VBox xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="iut.gon.gribouille_tp1.controleurs.CouleursControleur"
      prefHeight="283.0" prefWidth="107.0">
  <children>
    <ColorPicker fx:id="colorPicker" prefHeight="28.0" prefWidth="111.0">
      <opaqueInsets><Insets /></opaqueInsets>
    </ColorPicker>
    <TilePane prefHeight="258.0" prefWidth="129.0">
      <children>
        <Rectangle fx:id="rectRouge" arcHeight="5.0" arcWidth="5.0" fill="#ff1f1f" height="50.0" stroke="BLACK" strokeType="INSIDE" width="50.0">
          <TilePane.margin><Insets top="3.0" /></TilePane.margin>
        </Rectangle>
        <Rectangle fx:id="rectVert" arcHeight="5.0" arcWidth="5.0" fill="#00eb1c" height="50.0" stroke="BLACK" strokeType="INSIDE" width="50.0">
          <TilePane.margin><Insets left="3.0" top="3.0" /></TilePane.margin>
        </Rectangle>
        <Rectangle fx:id="rectBleu" arcHeight="5.0" arcWidth="5.0" fill="#3a17fc" height="50.0" stroke="BLACK" strokeType="INSIDE" width="50.0">
          <TilePane.margin><Insets top="3.0" /></TilePane.margin>
        </Rectangle>
        <Rectangle fx:id="rectCyan" arcHeight="5.0" arcWidth="5.0" fill="#1feeff" height="50.0" stroke="BLACK" strokeType="INSIDE" width="50.0">
          <TilePane.margin><Insets left="3.0" /></TilePane.margin>
        </Rectangle>
        <Rectangle fx:id="rectRose" arcHeight="5.0" arcWidth="5.0" fill="#ff00b7" height="50.0" stroke="BLACK" strokeType="INSIDE" width="50.0">
          <TilePane.margin><Insets top="3.0" /></TilePane.margin>
        </Rectangle>
        <Rectangle fx:id="rectJaune" arcHeight="5.0" arcWidth="5.0" fill="#fff600" height="50.0" stroke="BLACK" strokeType="INSIDE" width="50.0">
          <TilePane.margin><Insets left="3.0" top="3.0" /></TilePane.margin>
        </Rectangle>
        <Rectangle fx:id="rectNoir" arcHeight="5.0" arcWidth="5.0" height="50.0" stroke="BLACK" strokeType="INSIDE" width="50.0">
          <TilePane.margin><Insets top="3.0" /></TilePane.margin>
        </Rectangle>
        <Rectangle fx:id="rectBlanc" arcHeight="5.0" arcWidth="5.0" fill="WHITE" height="50.0" stroke="BLACK" strokeType="INSIDE" width="50.0">
          <TilePane.margin><Insets left="3.0" top="3.0" /></TilePane.margin>
        </Rectangle>
      </children>
    </TilePane>
  </children>
</VBox>