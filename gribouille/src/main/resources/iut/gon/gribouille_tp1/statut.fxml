<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<GridPane xmlns="http://javafx.com/javafx/25"
          xmlns:fx="http://javafx.com/fxml/1"
          fx:controller="iut.gon.gribouille_tp1.controleurs.StatutControleur">
  <columnConstraints>
    <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
    <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
    <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
    <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
    <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
  </columnConstraints>
  <rowConstraints>
    <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
  </rowConstraints>
  <children>
    <HBox prefHeight="100.0" prefWidth="200.0">
      <children>
        <Label prefHeight="31.0" prefWidth="59.0" text="X :" />
        <Label fx:id="labelX" prefHeight="30.0" prefWidth="141.0" text="0" />
      </children>
    </HBox>
    <HBox prefHeight="100.0" prefWidth="200.0" GridPane.columnIndex="1">
      <children>
        <Label prefHeight="30.0" prefWidth="88.0" text="Y :" />
        <Label fx:id="labelY" prefHeight="30.0" prefWidth="173.0" text="0" />
      </children>
    </HBox>
    <HBox prefHeight="100.0" prefWidth="200.0" GridPane.columnIndex="2">
      <children>
        <Label prefHeight="30.0" prefWidth="85.0" text="Epaisseur :" />
        <Label fx:id="labelEpaisseur" prefHeight="32.0" prefWidth="62.0" text="3" />
      </children>
    </HBox>
    <Label fx:id="labelOutil" prefHeight="33.0" prefWidth="120.0" text="Outil" GridPane.columnIndex="3" />
    <Label fx:id="labelCouleur" prefHeight="30.0" prefWidth="123.0" text="Couleur" GridPane.columnIndex="4" />
  </children>
</GridPane>